<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPOTTER.Mobile.MainPage"
             Title="SPOTTER">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="SPOTTER"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="GPS + gamepad test — Step 5"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <!-- ========= GPS ========= -->
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="StartButton"
                        Text="Start GPS"
                        Clicked="OnStartClicked"
                        HorizontalOptions="FillAndExpand" />
                <Button x:Name="StopButton"
                        Text="Stop GPS"
                        Clicked="OnStopClicked"
                        IsEnabled="False"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <Frame BorderColor="LightGray" Padding="12" CornerRadius="6">
                <VerticalStackLayout Spacing="6">
                    <Label Text="GPS status" FontAttributes="Bold" FontSize="12" />
                    <Label x:Name="StatusLabel" Text="Idle" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" Padding="12" CornerRadius="6">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Current fix" FontAttributes="Bold" FontSize="12" />
                    <Label x:Name="LatLabel" Text="Latitude: —" FontSize="14" />
                    <Label x:Name="LonLabel" Text="Longitude: —" FontSize="14" />
                    <Label x:Name="AltLabel" Text="Altitude: —" FontSize="14" />
                    <Label x:Name="BearingLabel" Text="Bearing: —" FontSize="14" />
                    <Label x:Name="SpeedLabel" Text="Speed: —" FontSize="14" />
                    <Label x:Name="AccLabel" Text="Horizontal accuracy: —" FontSize="14" />
                    <Label x:Name="FixTimeLabel" Text="Fix time: —" FontSize="14" />
                    <Label x:Name="FixCountLabel" Text="Fixes received: 0" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" Color="LightGray" />

            <!-- ========= Gamepad ========= -->
            <Frame BorderColor="LightGray" Padding="12" CornerRadius="6">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Gamepad" FontAttributes="Bold" FontSize="12" />
                    <Label x:Name="GamepadStatusLabel" Text="No controller connected" FontSize="14" />
                    <Label x:Name="GamepadLastButtonLabel" Text="Last button: —" FontSize="14" />
                    <Label x:Name="GamepadCountLabel" Text="Button presses: 0" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <Button x:Name="RumbleButton"
                    Text="Test rumble (1 second)"
                    Clicked="OnRumbleClicked" />

            <Label Text="To connect your Xbox One S controller: on the controller, hold the sync button on top until the Xbox light flashes. On iPad, open Settings → Bluetooth, tap the Xbox Wireless Controller when it appears, pair, then return here. In the Mac simulator, pair the controller to the Mac itself under System Settings → Bluetooth — the simulator will pass it through."
                   FontSize="11"
                   TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
