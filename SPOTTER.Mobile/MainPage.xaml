<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPOTTER.Mobile.MainPage"
             Title="SPOTTER">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="SPOTTER"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="GPS test — Step 4"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <HorizontalStackLayout Spacing="12">
                <Button x:Name="StartButton"
                        Text="Start GPS"
                        Clicked="OnStartClicked"
                        HorizontalOptions="FillAndExpand" />
                <Button x:Name="StopButton"
                        Text="Stop GPS"
                        Clicked="OnStopClicked"
                        IsEnabled="False"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <Frame BorderColor="LightGray" Padding="12" CornerRadius="6">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Status" FontAttributes="Bold" FontSize="12" />
                    <Label x:Name="StatusLabel" Text="Idle" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" Padding="12" CornerRadius="6">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Current fix" FontAttributes="Bold" FontSize="12" />
                    <Label x:Name="LatLabel" Text="Latitude: —" FontSize="14" />
                    <Label x:Name="LonLabel" Text="Longitude: —" FontSize="14" />
                    <Label x:Name="AltLabel" Text="Altitude: —" FontSize="14" />
                    <Label x:Name="BearingLabel" Text="Bearing: —" FontSize="14" />
                    <Label x:Name="SpeedLabel" Text="Speed: —" FontSize="14" />
                    <Label x:Name="AccLabel" Text="Horizontal accuracy: —" FontSize="14" />
                    <Label x:Name="FixTimeLabel" Text="Fix time: —" FontSize="14" />
                    <Label x:Name="FixCountLabel" Text="Fixes received: 0" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Note: the first Start on a fresh install triggers iOS's location-permission prompt. The app requests When-In-Use; background mode is declared for later use once a session is wired up."
                   FontSize="11"
                   TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
