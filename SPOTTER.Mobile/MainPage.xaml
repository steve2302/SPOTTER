<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPOTTER.Mobile.MainPage"
             Title="SPOTTER">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="SPOTTER"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Survey Program for Observing, Tracking, Tagging and Event Recording"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="iOS scaffold loaded"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label x:Name="CoreStatusLabel"
                   FontSize="14" />

            <Label x:Name="SessionStatusLabel"
                   FontSize="14" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Next steps on this scaffold:"
                   FontSize="14"
                   FontAttributes="Italic" />
            <Label Text="  · IGpsProvider implementation (CoreLocation)"
                   FontSize="12" />
            <Label Text="  · IGamepadProvider implementation (GameController framework)"
                   FontSize="12" />
            <Label Text="  · Session setup, observation entry, map, track log pages"
                   FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
